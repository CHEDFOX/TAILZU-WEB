{
  "rewrites": [
    { "source": "/v1/site", "destination": "https://api.tailzu.space/v1/site" },
    { "source": "/v1/site/event", "destination": "/api/site-event" },
    { "source": "/site-events.js", "destination": "/api/site-events" },
    { "source": "/v1/demo/transcribe", "destination": "https://api.tailzu.space/v1/demo/transcribe" },
    { "source": "/v1/pay/report", "destination": "https://api.tailzu.space/v1/pay/report" },
    { "source": "/download", "destination": "https://api.tailzu.space/download" },
    { "source": "/downloads/:file(Tailzu-Setup\\.exe|Tailzu\\.dmg|Tailzu\\.AppImage)", "destination": "https://api.tailzu.space/downloads/:file" },
    { "source": "/privacy", "destination": "https://api.tailzu.space/privacy" },
    { "source": "/terms", "destination": "https://api.tailzu.space/terms" },
    { "source": "/pricing", "destination": "https://api.tailzu.space/pricing" },
    { "source": "/pay", "destination": "https://api.tailzu.space/pay" },
    { "source": "/v1/pay/razorpay/:action(subscription|verify)", "destination": "https://api.tailzu.space/v1/pay/razorpay/:action" },
    { "source": "/.well-known/:path*", "destination": "https://api.tailzu.space/.well-known/:path*" },
    { "source": "/languages", "destination": "https://api.tailzu.space/languages" },
    { "source": "/languages/:slug", "destination": "https://api.tailzu.space/languages/:slug" },
    { "source": "/faq", "destination": "https://api.tailzu.space/faq" },
    { "source": "/ai-keyboard", "destination": "https://api.tailzu.space/ai-keyboard" },
    { "source": "/ai-keyboard/:device(android|iphone)", "destination": "https://api.tailzu.space/ai-keyboard/:device" },
    { "source": "/voice-typing", "destination": "https://api.tailzu.space/voice-typing" },
    { "source": "/voice-typing/:page(windows|mac|chatgpt)", "destination": "https://api.tailzu.space/voice-typing/:page" },
    { "source": "/sitemap.xml", "destination": "https://api.tailzu.space/sitemap.xml" },
    { "source": "/llms.txt", "destination": "https://api.tailzu.space/llms.txt" },
    { "source": "/llms-full.txt", "destination": "https://api.tailzu.space/llms-full.txt" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" }
      ]
    },
    {
      "source": "/((?!demo/).*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/demo/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'; object-src 'none'" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(|index\\.html)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self' 'sha256-uXE/ZpOOXOC7kkIfc0UF4ka+OUgkMqLXsZMP3tTMBv4=' 'sha256-hS9Si//FTD7G9zOqvtiS7iKBtG1A7i3gjWFPYZkVq0A=' 'sha256-0KCG6rg7BgyEr9VEAVDNqLE+/iL0s6svAi8sbRtg/b4=' https://connect.facebook.net https://www.googletagmanager.com; style-src 'self' 'sha256-4caL7OjaKFi/wMulxsZLqtRtyQmixnKzirBigPx9YUY=' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https://tailzu.space data: https://www.facebook.com https://www.googletagmanager.com https://*.google-analytics.com; media-src 'self'; connect-src 'self' https://api.tailzu.space https://www.facebook.com https://connect.facebook.net https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src https://www.googletagmanager.com 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'" }
      ]
    },
    {
      "source": "/(media|js)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/og.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/(favicon.svg|favicon.ico|apple-touch-icon.png|icon-512.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
